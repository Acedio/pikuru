#tempo 157
#ZenLen 40
#EchoVolume 20
#EchoLength 128
@flute flute adsr 15 4 4 7
@flug tpt adsr 15 1 1 7
@harp FM_Harp
@string string
@snare snare
@hat hat
!r l1. rr rr rr rr rr rr rr rr ; 8 bars
!r2 l1. rr rr rr rr ; halvsies
!snare l2.  v3	| crrc | rrcr | rrcr | rcrr
!hat   l4	v1	|< crr crr crr crr|

!s2 o2 l4 v3 | d1. a1.


!arp_a  o5 l2 e g
!arp_b  o4 l2 c e
