REQUIRE std.fth

REQUIRE cgram.fth
REQUIRE build/tiled-bg.map.fth
REQUIRE vram.fth

: COPY-TILED-BG
  TILED-BG-TILES
  TILED-BG-TILES-BANK
  TILED-BG-TILES-BYTES
  TILED-BG-TILE-BASE TILE-BASE-TO-VRAM-WORD
  DMA0-VRAM-LONG-TRANSFER
;

: COPY-TILED-BG-PALETTE
  TILED-BG-PAL
  TILED-BG-PAL-BANK
  TILED-BG-PAL-BYTES
  \ TODO: This is never actually used, the tilemap defaults to the 0th palette.
  0x20
  COPY-CGRAM-PALETTE-LONG
;

: TILED-BG-COPY-BG2
  TILED-BG-MAP TILED-BG-MAP-BANK
  TILED-BG-MAP-BASE MAP-BASE-TO-VRAM-WORD
  COPY-BG-TO-VRAM
;

BANK@
LOWRAM BANK!
CREATE SCROLLING-BG-TICKS 1 CELLS ALLOT
CREATE SCROLLING-BG-NMI-STATE 1 CELLS ALLOT
BANK!

: SCROLL-STARFIELD
  SCROLLING-BG-TICKS @
  LSR LSR LSR
  \ X for BG2
  DUP 0x210F C!
  DUP HIBYTE 0x210F C!
  \ Y for BG2
  LSR LSR
  DUP 0x2110 C!
  DUP HIBYTE 0x2110 C!

  \ X for BG3
  DUP 0x2111 C!
  DUP HIBYTE 0x2111 C!

  \ Y for BG3
  LSR LSR
  DUP 0x2112 C!
  HIBYTE 0x2112 C!
;

\ Returns TRUE when all initialization has completed.
( -- done-loading )
: SCROLLING-BG-NMI
  SCROLLING-BG-NMI-STATE @ CASE
    0 OF
      0x1460 SET-BACKDROP-COLOR

      COPY-TILED-BG
      COPY-TILED-BG-PALETTE

      1 SCROLLING-BG-NMI-STATE +!
      FALSE
    ENDOF
    1 OF
      TILED-BG-COPY-BG2

      1 SCROLLING-BG-NMI-STATE +!
      FALSE
    ENDOF
    2 OF
      0x02 0x02 BG-LAYER-ENABLE MASK!

      TILED-BG-TILE-BASE BG2-TILE-BASE!

      TILED-BG-MAP-BASE 0x2108 C!

      0x00 0x20 BG-MODE MASK!

      SCROLL-STARFIELD
      TRUE
    ENDOF
  ENDCASE
;

: SCROLLING-BG-INIT
  0 SCROLLING-BG-NMI-STATE !
  0 SCROLLING-BG-TICKS !
;

: SCROLLING-BG-MAIN
  1 SCROLLING-BG-TICKS +!
;
