REQUIRE std.fth

REQUIRE cgram.fth
REQUIRE joypad.fth
REQUIRE map.fth
REQUIRE oam.fth
REQUIRE snes-std.fth
REQUIRE vram.fth
REQUIRE build/sprites.spr.fth
REQUIRE build/level1.map.fth
REQUIRE build/level2.map.fth
REQUIRE build/level3.map.fth

5 CONSTANT NUM-BOXES

0
      DUP CONSTANT BOX-ISO-X
  2 + DUP CONSTANT BOX-ISO-Y
  2 + DUP CONSTANT BOX-ISO-Z
  2 + DUP CONSTANT BOX-SHADOW-ISO-Z
DROP

: BOXES 2* 2* 2* ;

BANK@
LOWRAM BANK!
CREATE STAGE-STATE 1 CELLS ALLOT
CREATE STAGE-NMI-STATE 1 CELLS ALLOT
CREATE STAGE-INDEX 1 CELLS ALLOT
\ 8.8 fixed point
CREATE PLAYER-ISO-X 1 CELLS ALLOT
CREATE PLAYER-ISO-Y 1 CELLS ALLOT
CREATE PLAYER-ISO-Z 1 CELLS ALLOT
CREATE PLAYER-DASH 1 CELLS ALLOT
CREATE TOP-BOX-ISO-X 1 CELLS ALLOT
CREATE TOP-BOX-ISO-Y 1 CELLS ALLOT
\ Used during draw routine.
CREATE TEMP-X 1 CELLS ALLOT
CREATE TEMP-Y 1 CELLS ALLOT
CREATE TEMP-Z 1 CELLS ALLOT
\ Deltas used during draw routine.
CREATE BOX-ISO-DELTA-X 1 CELLS ALLOT
CREATE BOX-ISO-DELTA-Y 1 CELLS ALLOT
CREATE TOP-BOX-VEL-X 1 CELLS ALLOT
CREATE TOP-BOX-VEL-Y 1 CELLS ALLOT
CREATE CAMERA-OFFSET-X 1 CELLS ALLOT
CREATE CAMERA-OFFSET-Y 1 CELLS ALLOT

CREATE SPRITES-TILES-LOADED-OFFSET 1 CELLS ALLOT

CREATE HEIGHTMAP-ADDR 1 CELLS ALLOT
CREATE HEIGHTMAP-BANK 1 CELLS ALLOT

CREATE TRUCK-ISO-X 1 CELLS ALLOT
CREATE TRUCK-ISO-Y 1 CELLS ALLOT
CREATE TRUCK-SCREEN-X 1 CELLS ALLOT
CREATE TRUCK-SCREEN-Y 1 CELLS ALLOT

CREATE PLAYER-MOVING 1 CELLS ALLOT
CREATE PLAYER-ANIMATION-FRAME 1 CELLS ALLOT

CREATE PLAYER-STATE 1 CELLS ALLOT
CREATE INVINCIBLE-FRAMES 1 CELLS ALLOT

CREATE BOX-DATA NUM-BOXES BOXES ALLOT
BANK!

\ Where iso 0,0 is in screen space
0      CONSTANT ISO-ORIGIN-SCREEN-X
32 8 * 8 + CONSTANT ISO-ORIGIN-SCREEN-Y

0x1D00 CONSTANT STAGE-BACKDROP-COLOR

0x0400 CONSTANT SPRITES-TILE-COPY-BYTES-PER-NMI

24 CONSTANT RUN-SPEED
0x2000 CONSTANT DASH-SPEED
0x0400 CONSTANT DASH-DECAY

0x0160 CONSTANT BOX-HEIGHT
0x0020 CONSTANT BOX-FALL-SPEED

45 CONSTANT MAX-INVINCIBLE-FRAMES

3 CONSTANT LAST-LEVEL

0
  1+ DUP CONSTANT PLAYER-STATE-WALKING
  1+ DUP CONSTANT PLAYER-STATE-DROPPING
  1+ DUP CONSTANT PLAYER-STATE-PICKING-UP
  1+ DUP CONSTANT PLAYER-STATE-INVINCIBLE
DROP

: 16/ 2/ 2/ 2/ 2/ ; LABEL DIV16

\ sx = ox+c(x+y)    sy = oy+0.5*c(y-x)
\ Need to multiply 8.8 fixed by 16 and then truncate to an unsigned word, so
\ divide by 16.
: ISO-TO-SCREEN-X ( iso-x iso-y -- screen-x )
  + 16/ ISO-ORIGIN-SCREEN-X +
;

\ Need to multiply 8.8 fixed by 8 and then truncate to an unsigned word, so
\ divide by 32.
: ISO-TO-SCREEN-Y ( iso-x iso-y -- screen-y )
  - NEGATE 16/ 2/ ISO-ORIGIN-SCREEN-Y +
;

\ iso-x and iso-y are in 8.8 fixed point.
: ISO-TO-SCREEN ( iso-x iso-y -- screen-x screen-y )
  2DUP ISO-TO-SCREEN-X -ROT
  ISO-TO-SCREEN-Y
;

\ TODO: This should be a native word, also unsure about the signature order.
: FC@ ( addr bank -- byte )
  BANK@ >R
  BANK! C@ R> BANK!
;

\ Grab the byte that represents what kind of tile (and height) is at iso-coords.
: TILE-BYTE ( iso-x iso-y -- tile-byte )
  \ Multiply iso-y (8.8) by 32 so LSR thrice and mask.
  2/ 2/ 2/ 0xFFE0 AND
  \ Get only the top 8 of X.
  SWAP HIBYTE
  + \ Add to get coord offset
  HEIGHTMAP-ADDR @ +
  HEIGHTMAP-BANK @
  FC@
;

: NEGATE-X?
  0x10 AND 0=
;

: NEGATE-Y?
  0x20 AND 0=
;

: ISO-Z ( iso-x iso-y -- iso-z )
  2DUP TILE-BYTE >R

  R@ 0xF0 AND 0x40 = IF
    \ Empty tile, return negative.
    2DROP R> DROP
    0xFF00
  ;THEN

  R@ 0xF0 AND 0= IF
    \ Flat, just return height.
    2DROP R> 0x0F AND SWAPBYTES
  ;THEN
  
  \ We're in some sort of slope case.
  R@ NEGATE-X? IF
    0xFF ROT 0xFF AND - SWAP
  ELSE
    SWAP 0xFF AND SWAP
  THEN
  R@ NEGATE-Y? IF
    0xFF SWAP 0xFF AND -
  ELSE
    0xFF AND
  THEN

  R@ 0xC0 AND CASE
    0x00 OF
      \ Only x
      DROP R> 0x0F AND SWAPBYTES +
    ENDOF
    0x40 OF
      \ Only y
      SWAP DROP R> 0x0F AND SWAPBYTES +
    ENDOF
    0x80 OF
      \ Min combine
      MIN R> 0x0F AND SWAPBYTES +
    ENDOF
    0xC0 OF
      \ Max combine
      MAX R> 0x0F AND SWAPBYTES +
    ENDOF
  ENDCASE
;

\ +1 if slope is increasing on that axis, -1 if decreasing, or 0 if no slope.
: ISO-SLOPE ( iso-x iso-y -- x-slope y-slope )
  2DUP TILE-BYTE >R
  \ Only care about the tile-relative coords for slope.
  SWAP 0xFF AND SWAP 0xFF AND

  R@ 0xF0 AND
  DUP 0x40 =
  SWAP 0 = OR IF
    \ Empty tile or flat, return no slope.
    2DROP R> DROP
    0 0
  ;THEN

  R@ 0xC0 AND 0= IF
    2DROP
    R> NEGATE-X? IF
      -1 0
    ELSE
      1 0
    THEN
  ;THEN
  R@ 0xC0 AND 0x40 = IF
    2DROP
    R> NEGATE-Y? IF
      0 -1
    ELSE
      0 1
    THEN
  ;THEN

  \ Stack: X Y

  \ TODO: I feel like this could be made simpler, but I don't want to spend
  \ the time on it now :P
  R@ NEGATE-Y? R@ NEGATE-X? = IF
    (
      *---x
      |\...
      | \..
      |  \.
      y   \

      Points in the shaded region have the following slopes:

         MIN  |  MAX
      x+  0 1 | 1  0
      x- -1 0 | 0 -1

      If X < Y, then SWAP the X and Y result.
    )
    < \ X < Y?
    R@ NEGATE-X? IF
      -1 0
    ELSE
      0 1
    THEN
    ROT R> 0xC0 AND 0xC0 = XOR IF
      SWAP
    THEN
  ELSE
    (
      *---x
      |.../
      |../ <- this is the 0x100 line.
      |./
      y/

      Points in the shaded region have the following slopes:

         MIN  |  MAX
      x+  1 0 |  0 -1
      x-  0 1 | -1  0

      If X + Y >= 0x100, SWAP the X and Y result.
    )

    + 0x100 >= \ X + Y >= 0x100
    R@ 0xC0 AND 0xC0 = XOR IF
      \ MAX combination
      0 -1
    ELSE
      1 0
    THEN
    R> NEGATE-X? IF
      SWAP
    THEN
  THEN
;

: COORD-SUB ( ax ay bx by -- ax-bx ay-by )
  ROT SWAP -
  -ROT -
  SWAP
;

: COORD-ADD ( ax ay bx by -- ax+bx ay+by )
  ROT +
  -ROT +
  SWAP
;

: COPY-SPRITES
  SPRITES-TILES SPRITES-TILES-LOADED-OFFSET @ +
  SPRITES-TILES-BANK
  SPRITES-TILE-COPY-BYTES-PER-NMI
  OAM-TILE-BASE OAM-TILE-BASE-TO-VRAM-WORD SPRITES-TILES-LOADED-OFFSET @ 2/ +
  DMA0-VRAM-LONG-TRANSFER

  SPRITES-TILE-COPY-BYTES-PER-NMI SPRITES-TILES-LOADED-OFFSET +!
  SPRITES-TILES-LOADED-OFFSET @ SPRITES-TILES-BYTES @ >=
;

: COPY-SPRITES-PALETTE
  SPRITES-PAL
  SPRITES-PAL-BANK
  SPRITES-PAL-BYTES
  0x80
  COPY-CGRAM-PALETTE-LONG
;

1
  DUP CONSTANT PLAYER-PANIC-OAM-OBJECT
  1+
  DUP CONSTANT PLAYER-BOTTOM-OAM-OBJECT
  1+
  DUP CONSTANT PLAYER-TOP-OAM-OBJECT
  1+
  DUP CONSTANT BOX0-OAM-OBJECT
  NUM-BOXES +
  DUP CONSTANT BOX0-SHADOW-OAM-OBJECT
  NUM-BOXES +
  DUP CONSTANT TRUCK-OAM-OBJECT
  1+
DROP

: ISO-Z-TO-Y-OFFSET ( iso-z -- screen-y-offset )
  2* 2* 2* HIBYTE 
;

: RENDER-STACKED-BOXES
  TOP-BOX-ISO-X @ TOP-BOX-ISO-Y @
  PLAYER-ISO-X @ PLAYER-ISO-Y @ COORD-SUB
  2/TZ 2/TZ BOX-ISO-DELTA-Y !
  2/TZ 2/TZ BOX-ISO-DELTA-X !

  PLAYER-ISO-X @ 0x080 + TEMP-X !
  PLAYER-ISO-Y @ 0x040 + TEMP-Y !
  PLAYER-ISO-Z @ 0x160 + TEMP-Z !

  NUM-BOXES 0 DO
    BOX-DATA I BOXES +
      TEMP-X @ OVER BOX-ISO-X + !
      TEMP-Y @ OVER BOX-ISO-Y + !
      TEMP-Z @ OVER BOX-ISO-Z + !

      TEMP-X @ TEMP-Y @ ISO-Z
      OVER BOX-SHADOW-ISO-Z + !
    DROP

    BOX-ISO-DELTA-X @ TEMP-X +!
    BOX-ISO-DELTA-Y @ TEMP-Y +!
    BOX-HEIGHT TEMP-Z +!
  LOOP
;

: BOX-SCREEN-COORD ( addr -- sx sy )
  DUP BOX-ISO-X + @ OVER BOX-ISO-Y + @ ISO-TO-SCREEN
  ROT BOX-ISO-Z + @ ISO-Z-TO-Y-OFFSET -
;

: DRAW-BOX ( oam-obj addr -- )
  BOX-SCREEN-COORD
  CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @ COORD-SUB
  SWAP 8 - SWAP 16 -
  \ For some reason OAM-OBJECT-COORDS! takes y before x.
  SWAP
  ROT OAM-OBJECT-COORDS-WITHOUT-NEGX!
;

: DRAW-BOX-SHADOW ( oam-obj addr -- )
  DUP BOX-SHADOW-ISO-Z + @
  DUP 0< IF \ oam-obj box-addr box-z
    2DROP
    -32 0 ROT OAM-OBJECT-COORDS-WITHOUT-NEGX!
  ELSE \ oam-boj box-addr box-z
    OVER BOX-ISO-X + @
    ROT BOX-ISO-Y + @
    ISO-TO-SCREEN
    ROT ISO-Z-TO-Y-OFFSET -
    CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @ COORD-SUB
    SWAP 8 - SWAP 16 -
    \ For some reason OAM-OBJECT-COORDS! takes y before x.
    SWAP
    ROT OAM-OBJECT-COORDS-WITHOUT-NEGX!
  THEN
;

: DRAW-BOXES ( -- )
  NUM-BOXES 0 DO
    BOX-DATA I BOXES +

    BOX0-OAM-OBJECT NUM-BOXES 1- + I - OVER DRAW-BOX

    BOX0-SHADOW-OAM-OBJECT NUM-BOXES 1- + I - SWAP DRAW-BOX-SHADOW
  LOOP
;

( -- )
: DRAW-PLAYER
  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-TO-SCREEN
  PLAYER-ISO-Z @ ISO-Z-TO-Y-OFFSET -
  CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @ COORD-SUB
  SWAP 8 - SWAP 16 -
  \ For some reason OAM-OBJECT-COORDS! takes y before x.
  2DUP SWAP
  PLAYER-BOTTOM-OAM-OBJECT OAM-OBJECT-COORDS-WITHOUT-NEGX!

  16 -
  SWAP PLAYER-TOP-OAM-OBJECT OAM-OBJECT-COORDS-WITHOUT-NEGX!
;

: DRAW-TRUCK ( -- )
  TRUCK-SCREEN-X @ CAMERA-OFFSET-X @ -
  DUP -64 < OVER 256 > OR IF
    DROP
    0 257 TRUCK-OAM-OBJECT OAM-OBJECT-COORDS!
  ;THEN
  TRUCK-SCREEN-Y @ CAMERA-OFFSET-Y @ -
  DUP -64 < OVER 224 > OR IF
    2DROP
    0 257 TRUCK-OAM-OBJECT OAM-OBJECT-COORDS!
  ;THEN
  SWAP TRUCK-OAM-OBJECT OAM-OBJECT-COORDS!
;

: 3/4 ( i -- 3/4*i )
  2/ DUP 2/ +
;

: GET-JOY-DIR-ORTHO ( -- xsign ysign )
  JOY1-HELD @ >R
    0 0
    R@ BUTTON-LEFT AND IF
      -1 -1 COORD-ADD
    THEN
    R@ BUTTON-RIGHT AND IF
      1 1 COORD-ADD
    THEN
    R@ BUTTON-UP AND IF
      1 -1 COORD-ADD
    THEN
    R@ BUTTON-DOWN AND IF
      -1 1 COORD-ADD
    THEN
    DUP 0= IF
      DROP 2/ 0
    THEN
    OVER 0= IF
      2/
    THEN
  R> DROP
;

: GET-JOY-DIR ( -- xsign ysign )
  JOY1-HELD @ >R
    0
    R@ BUTTON-LEFT AND IF
      1-
    THEN
    R@ BUTTON-RIGHT AND IF
      1+
    THEN
    0
    R@ BUTTON-UP AND IF
      1-
    THEN
    R@ BUTTON-DOWN AND IF
      1+
    THEN
  R> DROP
;

: TAKE-SIGN ( sign magnitude -- signed-magnitude )
  OVER 0= IF
    DROP \ Leave the 0.
  ;THEN
  SWAP 0< IF
    NEGATE
  THEN
;

\ Scale ({-1,0,1}, {-1,0,1}) coordinate directions by the `scale` amount,
\ accounting for the case where diagonals scale less (to yield the same-ish
\ magnitude).
: SCALE-DIR ( xsign ysign scale -- x y )
  -ROT OVER 0<> OVER 0<> AND IF
    \ Both directions pressed.
    ROT 3/4
  ELSE
    ROT
  THEN
  TUCK
  TAKE-SIGN
  -ROT
  TAKE-SIGN
  SWAP
;

\ If the signs match, double the value. If they're opposite, halve. If 0, no-op.
: SIGN-AMPLIFY ( vel sign -- scaled-vel )
  DUP 0= IF
    \ No slope, no scale.
    DROP
  ;THEN
  OVER XOR 0x8000 AND 0<> IF
    \ Match, double.
    2*
  ELSE
    \ Opposite, halve.
    2/TZ
  THEN
;

: SCALE-FOR-SLOPE ( xvel yvel -- scaled-x scaled-y )
  >R
  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-SLOPE
  \ X first
  -ROT SIGN-AMPLIFY
  R> ROT SIGN-AMPLIFY
;

\ # Calculating thresholds for drop detection #
\
\ We do this based on an octagonal perimeter around the player. Using the
\ absolute delta between player and jars:
\
\ y
\ ^
\ |--    <- ortho threshold (x < ortho && y < ortho)
\ |  \  <-- diagonal threshold (x + y < diag)
\ |   \
\ |    |
\ -------->x

\ X and Y must be less than this.
256 CONSTANT ORTHO-THRESHOLD-SCALER
\ The 8.8 scaler for the diagonal threshold calculations (X + Y < THRESHOLD)
\
\ For a regular octagon, the diagonal threshold is (1 + 2^-0.5) times the ortho.
\ That's 437 in 8.8.
437 CONSTANT DIAG-THRESHOLD-SCALER

\ 2.5x the scaler.
5 DIAG-THRESHOLD-SCALER * 2/TZ CONSTANT DROP-THRESHOLD-DIAG
5 ORTHO-THRESHOLD-SCALER * 2/TZ CONSTANT DROP-THRESHOLD-ORTHO

\ 1.5x the scaler.
3 DIAG-THRESHOLD-SCALER * 2/TZ CONSTANT PANIC-THRESHOLD-DIAG
3 ORTHO-THRESHOLD-SCALER * 2/TZ CONSTANT PANIC-THRESHOLD-ORTHO

: ABS ( val -- abs-val )
  \ e.g. 21 ABS  ->  21
  \                 ()()
  \                 ()()
  \                 ()()

  DUP 0< IF NEGATE THEN
;

: PANICKING? ( dx dy -- panicking? )
  ABS SWAP ABS
  DUP PANIC-THRESHOLD-ORTHO > IF
    2DROP TRUE
  ;THEN
  OVER PANIC-THRESHOLD-ORTHO > IF
    2DROP TRUE
  ;THEN
  + PANIC-THRESHOLD-DIAG >
;

: DROPPED? ( dx dy -- dropped? )
  ABS SWAP ABS
  DUP DROP-THRESHOLD-ORTHO > IF
    2DROP TRUE
  ;THEN
  OVER DROP-THRESHOLD-ORTHO > IF
    2DROP TRUE
  ;THEN
  + DROP-THRESHOLD-DIAG >
;

: HANDLE-JOY
  JOY1-PRESSED @ BUTTON-Y AND IF
    DASH-SPEED PLAYER-DASH !
  ELSE
    \ Decay the dash, stopping at 0.
    PLAYER-DASH @ DASH-DECAY -
    DUP 0 < IF DROP 0 THEN
    PLAYER-DASH !
  THEN

  GET-JOY-DIR-ORTHO
  2DUP 0= SWAP 0= AND 0= PLAYER-MOVING !
  \ 2DUP 
  RUN-SPEED PLAYER-DASH @ HIBYTE + SCALE-DIR
  SCALE-FOR-SLOPE
  PLAYER-ISO-Y @ + TEMP-Y !
  PLAYER-ISO-X @ + TEMP-X !
  (
  RUN-SPEED 2/TZ 2/TZ SCALE-DIR
  TOP-BOX-ISO-Y +!
  TOP-BOX-ISO-X +!
  )

  TEMP-X @ TEMP-Y @ ISO-Z

  DUP 0< IF
    DROP
  ELSE
    TEMP-X @ PLAYER-ISO-X !
    TEMP-Y @ PLAYER-ISO-Y !
    PLAYER-ISO-Z !
  THEN
;

\ This rounds towards 0, which means that the INT-PART of -0.2 is 0.
: 8.8-INT-PART ( 8.8-fixed -- int-part )
  256/TZ
;

\ The amount of acceleration based on how far away the top box is.
: ACCEL-FROM-DISTANCE ( iso-distance -- acceleration )
  2/TZ 2/TZ 2/TZ
;

: UPDATE-BOX
  TOP-BOX-ISO-X @ PLAYER-ISO-X @ - ACCEL-FROM-DISTANCE TOP-BOX-VEL-X +!
  TOP-BOX-ISO-Y @ PLAYER-ISO-Y @ - ACCEL-FROM-DISTANCE TOP-BOX-VEL-Y +!
  TOP-BOX-VEL-X @ DUP 2* 2* 256/TZ - TOP-BOX-VEL-X !
  TOP-BOX-VEL-Y @ DUP 2* 2* 256/TZ - TOP-BOX-VEL-Y !
  TOP-BOX-VEL-X @ 8.8-INT-PART TOP-BOX-ISO-X +!
  TOP-BOX-VEL-Y @ 8.8-INT-PART TOP-BOX-ISO-Y +!
;

: UPDATE-BOX-INVINCIBLE
  0 TOP-BOX-VEL-X !
  0 TOP-BOX-VEL-Y !
  PLAYER-ISO-X @ TOP-BOX-ISO-X !
  PLAYER-ISO-Y @ TOP-BOX-ISO-Y !
;

: STAGE-NMI
  STAGE-NMI-STATE @ CASE
    0 OF
      FADE-OUT IF
        1 STAGE-NMI-STATE +!
      THEN
      0 SPRITES-TILES-LOADED-OFFSET !
    ENDOF
    1 OF
      COPY-SPRITES IF
        1 STAGE-NMI-STATE +!
      THEN
    ENDOF
    2 OF
      STAGE-BACKDROP-COLOR SET-BACKDROP-COLOR
      COPY-SPRITES-PALETTE
      1 STAGE-NMI-STATE +!
    ENDOF
    3 OF
      \ TODO: This doesn't actually have to be in NMI since we're operating on
      \ the shadow OAM
      FALSE PLAYER-TOP-OAM-OBJECT OAM-OBJECT-LARGE!
      0x30 SHADOW-OAM-LOWER PLAYER-TOP-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-ATTRIBUTES C!
      64 SHADOW-OAM-LOWER PLAYER-TOP-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!
      FALSE PLAYER-TOP-OAM-OBJECT OAM-OBJECT-NEGATIVE-X!
      FALSE PLAYER-BOTTOM-OAM-OBJECT OAM-OBJECT-LARGE!
      0x30 SHADOW-OAM-LOWER PLAYER-BOTTOM-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-ATTRIBUTES C!
      96 SHADOW-OAM-LOWER PLAYER-BOTTOM-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!
      FALSE PLAYER-BOTTOM-OAM-OBJECT OAM-OBJECT-NEGATIVE-X!

      TRUE TRUCK-OAM-OBJECT OAM-OBJECT-LARGE!
      0x30 SHADOW-OAM-LOWER TRUCK-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-ATTRIBUTES C!
      136 SHADOW-OAM-LOWER TRUCK-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!
      FALSE TRUCK-OAM-OBJECT OAM-OBJECT-NEGATIVE-X!

      NUM-BOXES 0 DO
        FALSE BOX0-OAM-OBJECT I + OAM-OBJECT-LARGE!
        0x30 SHADOW-OAM-LOWER BOX0-OAM-OBJECT I + OAM-LOWER-OBJECTS + OAM-ATTRIBUTES C!
        164 SHADOW-OAM-LOWER BOX0-OAM-OBJECT I + OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!

        FALSE BOX0-SHADOW-OAM-OBJECT I + OAM-OBJECT-LARGE!
        0x30 SHADOW-OAM-LOWER BOX0-SHADOW-OAM-OBJECT I + OAM-LOWER-OBJECTS + OAM-ATTRIBUTES C!
        198 SHADOW-OAM-LOWER BOX0-SHADOW-OAM-OBJECT I + OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!
      LOOP

      1 STAGE-NMI-STATE +!
    ENDOF
    4 OF
      MAP-NMI IF
        1 STAGE-NMI-STATE +!
      THEN
    ENDOF
    5 OF
      FADE-IN DROP

      MAP-NMI DROP

      \ Set 16x16 and 64x64 for OAM sizes, and set the tile base.
      0x80 OAM-TILE-BASE OR 0x2101 C!

      \ TODO: Copying this below STARS-NMI causes issues.
      COPY-OAM

      \ Enable sprite layer and BG1. Disable the rest.
      0x11 0x1F BG-LAYER-ENABLE MASK!
    ENDOF
  ENDCASE
;

: INIT-BOXES ( -- )
  \ We'll just assume boxes are always on screen.
  NUM-BOXES 0 DO
    FALSE BOX0-OAM-OBJECT I + OAM-OBJECT-NEGATIVE-X!
    FALSE BOX0-SHADOW-OAM-OBJECT I + OAM-OBJECT-NEGATIVE-X!
  LOOP
;

: LOAD-LEVEL-METADATA ( metadata-addr metadata-bank -- )
  BANK@ >R
  BANK!
  DUP     @ SWAPBYTES 0x80 + PLAYER-ISO-X !
  DUP 2 + @ SWAPBYTES 0x80 + PLAYER-ISO-Y !
  DUP 4 + @ TRUCK-ISO-X !
  DUP 6 + @ TRUCK-ISO-Y !
  R> BANK!
;

: FINISHED?
  PLAYER-ISO-X @ 8.8-INT-PART TRUCK-ISO-X @ =
  PLAYER-ISO-Y @ 8.8-INT-PART TRUCK-ISO-Y @ =
  AND
;

: INIT-TRUCK
  TRUCK-ISO-X @ SWAPBYTES TRUCK-ISO-Y @ SWAPBYTES ISO-TO-SCREEN
  TRUCK-ISO-X @ SWAPBYTES TRUCK-ISO-Y @ SWAPBYTES ISO-Z ISO-Z-TO-Y-OFFSET -
  40 - TRUCK-SCREEN-Y !
  10 + TRUCK-SCREEN-X !
;

: RESTART-LEVEL ( -- )
  0 STAGE-NMI-STATE !

  STAGE-INDEX @ CASE
    1 OF
      LEVEL1-HEIGHTMAP HEIGHTMAP-ADDR !
      LEVEL1-HEIGHTMAP-BANK HEIGHTMAP-BANK !
      LEVEL1-METADATA LEVEL1-METADATA-BANK LOAD-LEVEL-METADATA
    ENDOF
    2 OF
      LEVEL2-HEIGHTMAP HEIGHTMAP-ADDR !
      LEVEL2-HEIGHTMAP-BANK HEIGHTMAP-BANK !
      LEVEL2-METADATA LEVEL2-METADATA-BANK LOAD-LEVEL-METADATA
    ENDOF
    3 OF
      LEVEL3-HEIGHTMAP HEIGHTMAP-ADDR !
      LEVEL3-HEIGHTMAP-BANK HEIGHTMAP-BANK !
      LEVEL3-METADATA LEVEL3-METADATA-BANK LOAD-LEVEL-METADATA
    ENDOF
  ENDCASE

  PLAYER-STATE-WALKING PLAYER-STATE !

  0 PLAYER-ANIMATION-FRAME !

  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-Z PLAYER-ISO-Z !
  0x0000 PLAYER-DASH !
  PLAYER-ISO-X @ TOP-BOX-ISO-X !
  PLAYER-ISO-Y @ TOP-BOX-ISO-Y !
  0x0000 TOP-BOX-VEL-X !
  0x0000 TOP-BOX-VEL-Y !

  INIT-TRUCK

  INIT-BOXES

  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-TO-SCREEN
  128 - CAMERA-OFFSET-Y !
  128 - CAMERA-OFFSET-X !

  STAGE-INDEX @ CASE
    1 OF
      CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @
      LEVEL1-MAP
      LEVEL1-MAP-BANK
      LEVEL1-MAP-BYTES
      LEVEL1-TILES
      LEVEL1-TILES-BANK
      LEVEL1-TILES-BYTES
      LEVEL1-PAL
      LEVEL1-PAL-BANK
      LEVEL1-PAL-BYTES
      MAP-INIT
    ENDOF
    2 OF
      CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @
      LEVEL2-MAP
      LEVEL2-MAP-BANK
      LEVEL2-MAP-BYTES
      LEVEL2-TILES
      LEVEL2-TILES-BANK
      LEVEL2-TILES-BYTES
      LEVEL2-PAL
      LEVEL2-PAL-BANK
      LEVEL2-PAL-BYTES
      MAP-INIT
    ENDOF
    3 OF
      CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @
      LEVEL3-MAP
      LEVEL3-MAP-BANK
      LEVEL3-MAP-BYTES
      LEVEL3-TILES
      LEVEL3-TILES-BANK
      LEVEL3-TILES-BYTES
      LEVEL3-PAL
      LEVEL3-PAL-BANK
      LEVEL3-PAL-BYTES
      MAP-INIT
    ENDOF
  ENDCASE
;

: STAGE-INIT
  1 STAGE-INDEX !
  RESTART-LEVEL
;

: WALKING-TILE ( frame -- tile-id )
  PLAYER-MOVING @ 0= IF
    DROP 224 \ Standing still.
  ;THEN
  DUP 2 < IF
    96
  ;THEN
  2 -
  DUP 5 < IF
    2* 96 +
  ;THEN
  5 -
  DUP 2 < IF
    106
  ;THEN
  2 -
  DUP 3 < IF
    2* 106 +
  ;THEN
  3 -
  2* 160 +
;

: HANDLE-WALKING
  HANDLE-JOY

  FINISHED? IF
    1 STAGE-INDEX +!
    STAGE-INDEX @ LAST-LEVEL > IF
      TRUE
    ;THEN
    RESTART-LEVEL
  THEN

  PLAYER-ANIMATION-FRAME @
  1+
  DUP 14 >= IF
    DROP 0
  THEN
  DUP PLAYER-ANIMATION-FRAME !
  WALKING-TILE SHADOW-OAM-LOWER PLAYER-BOTTOM-OAM-OBJECT OAM-LOWER-OBJECTS + OAM-TILE-NUMBER C!

  UPDATE-BOX

  PLAYER-ISO-X @ PLAYER-ISO-Y @ TOP-BOX-ISO-X @ TOP-BOX-ISO-Y @ COORD-SUB

  DROPPED? IF
    PLAYER-STATE-DROPPING PLAYER-STATE !
  THEN

  RENDER-STACKED-BOXES

  FALSE
;

: HANDLE-DROPPING
  TRUE \ Whether all are done falling.
  NUM-BOXES 0 DO
    BOX-DATA I BOXES +

    DUP BOX-ISO-Z + @
    OVER BOX-SHADOW-ISO-Z + @
    OVER < IF \ addr iso-z
      BOX-FALL-SPEED - SWAP BOX-ISO-Z + !
      DROP FALSE \ We're not done falling.
    ELSE
      2DROP
    THEN
  LOOP
  IF
    PLAYER-STATE-INVINCIBLE PLAYER-STATE !
    MAX-INVINCIBLE-FRAMES INVINCIBLE-FRAMES !
    PLAYER-ISO-X @ TOP-BOX-ISO-X !
    PLAYER-ISO-Y @ TOP-BOX-ISO-Y !
    0x0000 TOP-BOX-VEL-X !
    0x0000 TOP-BOX-VEL-Y !
  THEN
;

: HANDLE-INVINCIBLE
  HANDLE-JOY

  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-Z

  DUP 0< IF
    DROP RESTART-LEVEL
  ELSE
    PLAYER-ISO-Z !
  THEN

  FINISHED? IF
    1 STAGE-INDEX +!
    STAGE-INDEX @ LAST-LEVEL > IF
      TRUE
    ;THEN
    RESTART-LEVEL
  THEN

  UPDATE-BOX-INVINCIBLE

  RENDER-STACKED-BOXES

  -1 INVINCIBLE-FRAMES +!
  INVINCIBLE-FRAMES @ 0 <= IF
    PLAYER-STATE-WALKING PLAYER-STATE !
  THEN

  FALSE
;

: STAGE-MAIN
  PLAYER-STATE @ CASE
    PLAYER-STATE-WALKING OF
      HANDLE-WALKING
    ENDOF
    PLAYER-STATE-DROPPING OF
      HANDLE-DROPPING
      FALSE
    ENDOF
    PLAYER-STATE-PICKING-UP OF
      \ TODO: HANDLE-PICKING-UP
      FALSE
    ENDOF
    PLAYER-STATE-INVINCIBLE OF
      HANDLE-INVINCIBLE
    ENDOF
  ENDCASE

  \ TODO: Why are these the correct offsets?
  PLAYER-ISO-X @ PLAYER-ISO-Y @ ISO-TO-SCREEN
  128 - CAMERA-OFFSET-Y !
  128 - CAMERA-OFFSET-X !

  CAMERA-OFFSET-X @ CAMERA-OFFSET-Y @ MAP-MAIN

  DRAW-PLAYER
  
  DRAW-TRUCK

  DRAW-BOXES
;
